{
  "expo": {
    "name": "CatchUp",
    "slug": "catchup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "catchup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spencerlee.catchup",
      "buildNumber": "1",
      "infoPlist": {
        "NSContactsUsageDescription": "CatchUp uses your contacts to let you connect existing contact info to friends you want to keep up with. You choose which contacts to import.",
        "NSCalendarsUsageDescription": "CatchUp can sync your scheduled catch-ups to your calendar so they appear alongside your other events."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "package": "com.spencerlee.catchup",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fdf8f3",
          "dark": {
            "backgroundColor": "#1f1a17"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "CatchUp uses your contacts to let you link friends to their existing contact info for quick messaging and calling."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
